{
  "appId": "net.voicemaster.app",
  "appName": "المدرب الصوتي",
  "webDir": "www",
  "bundledWebRuntime": false,
  "server": {
    "url": "https://voicemaster.is-best.net/index.php",
    "cleartext": false,
    "allowNavigation": ["voicemaster.is-best.net"]
  },
  "android": {
    "backgroundColor": "#fefaf7",
    "allowMixedContent": false,
    "captureInput": true
  },
  "plugins": {
    "SplashScreen": {
      "launchShowDuration": 2000,
      "backgroundColor": "#fefaf7",
      "showSpinner": false
    },
    "StatusBar": {
      "style": "DEFAULT",
      "backgroundColor": "#c28143",
      "overlaysWebView": false
    }
  }
}
